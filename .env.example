# Copie para .env.local e preencha.

# WhatsApp comercial: só dígitos, com DDI + DDD (ex.: 5548999999999)
NEXT_PUBLIC_WHATSAPP=5548900000000

# URL pública do projeto (usada em metadados/Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook que recebe os leads dos formulários (Zapier, Make, n8n, Apps Script, CRM…).
# Em produção, sem isso o formulário mostra o fallback do WhatsApp.
LEAD_WEBHOOK_URL=

# --- Dois domínios (opcional) ---
# Hosts que devem abrir o site do empreendimento na raiz "/", separados por vírgula
EMPREENDIMENTO_HOSTS=
# URLs absolutas usadas nos links entre os dois sites (deixe vazio em dev)
NEXT_PUBLIC_IMOBILIARIA_URL=
NEXT_PUBLIC_EMPREENDIMENTO_URL=

# --- Higgsfield (npm run higgsfield) ---
# Crie a chave no Console do Higgsfield. Use só localmente/servidor, nunca no front-end.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
